rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /product-videos/{category}/{fileName} {
      allow read: if true;
      // Anyone can upload a video up to 100 MB.
      allow write: if request.resource != null
                   && request.resource.size <= 104857600
                   && request.resource.contentType.matches('video/.*');
    }
  }
}
